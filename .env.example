# Copy this file to .env and replace password placeholders before starting services.
MYSQL_DATABASE=coinbase_analytics
MYSQL_USER=analytics_writer
MYSQL_PASSWORD=replace_with_a_local_writer_password
MYSQL_ROOT_PASSWORD=replace_with_a_local_root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3307

# Grafana administrator credentials for http://localhost:3000.
GRAFANA_ADMIN_USER=replace_admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_local_grafana_admin_password
